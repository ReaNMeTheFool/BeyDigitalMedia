{
  "name": "beydigitalmedia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beydigitalmedia",
      "database_id": "eb3df19d-c4b4-4d59-818d-cda91e2cd1ba"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "beydigitalmedia-media"
    }
  ]
}
