{
  "name": "beydigitalmedia",
  "account_id": "9141694319c7507693fd8c4947bdc5ad",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beydigitalmedia",
      "database_id": "a6bf3e14-9b19-4a77-b304-eed22d87bc9b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "beydigitalmedia-media"
    }
  ]
}
