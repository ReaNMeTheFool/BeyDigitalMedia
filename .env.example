# Uygulama: Cloudflare Workers + D1 + R2 uzerinde calisir.
# Yerel gelistirme icin ayni degiskenler .dev.vars dosyasina yazilir (ornek: .dev.vars.example).
# Cloudflare uzerinde: wrangler secret put <AD> (Detay: DEPLOY-CLOUDFLARE.md)

# Sitenin canli adresi (og:image, sitemap, canonical URL'leri uretir)
NEXT_PUBLIC_SERVER_URL=

# E-posta gonderimi icin Resend API anahtari
RESEND_API_KEY=

# Iletisim formu bildirimlerinin gidecegi e-posta adresi
RECIPIENT_EMAIL=

# E-postalarin gorunecek gonderen adresi (Resend'de dogrulanmis alan adi olmali)
RESEND_FROM_EMAIL=

# Mini admin panel giris kullanici adi
ADMIN_USERNAME=

# Mini admin panel giris sifresi
ADMIN_PASSWORD=

# Admin oturum cookie'sini imzalayan gizli anahtar (en az 32 byte rastgele deger)
AUTH_SECRET=
